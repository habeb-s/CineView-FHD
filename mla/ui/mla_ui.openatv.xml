<?xml version="1.0" encoding="utf-8"?>
<!-- CineView MLA control screens. Built only from the approved CineView templates
     (BasicTemplate / ConfigTemplate / DescriptionTemplate / ButtonTemplate) so the
     selector keeps the CineView identity; the PIG slot shows the design preview instead. -->
<skin>
	<screen name="CineViewMLASetup" position="fill" title="CineView Designs" flags="wfNoBorder">
		<panel name="BasicTemplate" />
		<eLabel position="26,116" size="728,413" backgroundColor="#007c7c7c" zPosition="0" />
		<widget name="preview" position="30,120" size="720,405" zPosition="1" alphatest="blend" scale="1" />
		<!-- CineView Info Card (user 2026-10-07): shown instead of the preview for rows without a visual preview -->
		<widget name="info_bg" position="30,120" size="720,405" zPosition="2" backgroundColor="steThemePanel" />
		<widget name="info_accent" position="30,120" size="720,6" zPosition="3" backgroundColor="steThemeAccent" />
		<widget name="info_icon" position="60,150" size="160,69" zPosition="3" alphatest="blend" />
		<widget name="info_title" position="60,238" size="660,44" zPosition="3" font="Regular;32" foregroundColor="secondFG" backgroundColor="steThemePanel" transparent="1" valign="center" noWrap="1" />
		<widget name="info_text" position="60,288" size="660,110" zPosition="3" font="Regular;26" foregroundColor="steThemeText" backgroundColor="steThemePanel" transparent="1" valign="top" />
		<widget name="info_value" position="60,404" size="660,40" zPosition="3" font="Regular;26" foregroundColor="steThemeText" backgroundColor="steThemePanel" transparent="1" valign="center" noWrap="1" />
		<widget name="info_restart" position="60,450" size="660,60" zPosition="3" font="Regular;23" foregroundColor="steThemeMuted" backgroundColor="steThemePanel" transparent="1" valign="top" />
		<!-- ConfigTemplate's frame, with its own list: 13 whole rows (832 = 13 x 64, no half-drawn row at the bottom)
		     and a readable value font (the image default draws the values at ~18 px).  t98 2026-10-06. -->
		<eLabel position="770,95" size="1120,905" backgroundColor="steThemePanelAlt" zPosition="-2" />
		<eLabel position="760,95" size="2,905" backgroundColor="#00444444" zPosition="-1" />
		<widget name="config" position="790,115" size="1090,832" itemHeight="64" font="Regular;30" valueFont="Regular;27" scrollbarMode="showOnDemand" />
		<panel name="DescriptionTemplate" />
		<widget name="status" position="35,885" size="700,100" zPosition="2" font="Regular;24" foregroundColor="steThemeMuted" transparent="1" valign="top" />
		<panel name="ButtonTemplate" />
	</screen>
	<screen name="CineViewMLAPreview" position="0,0" size="1920,1080" title="Preview" flags="wfNoBorder" backgroundColor="#ff000000">
		<widget name="image" position="0,0" size="1920,1080" zPosition="1" alphatest="blend" scale="1" />
	</screen>
</skin>
