<?xml version="1.0" encoding="utf-8"?>
<!-- RTL one-line title experiment (TextTest2 'file' = this absolute path). Each row: one RunningText config. -->
<skin>
	<screen name="RTLTest" position="fill" flags="wfNoBorder">
		<eLabel position="80,80" size="1760,900" backgroundColor="#08182B" zPosition="1" />
		<eLabel text="A swimming,left halign=right noWrap" position="100,100" size="700,30" font="Regular;22" foregroundColor="#B6B6B6" backgroundColor="#08182B" zPosition="2" />
